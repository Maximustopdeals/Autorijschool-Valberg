{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "redirects": [
    { "source": "/diensten/", "destination": "/rijlessen/", "permanent": true },
    { "source": "/diensten", "destination": "/rijlessen/", "permanent": true },
    { "source": "/gratis-proefles/", "destination": "/proefles/", "permanent": true },
    { "source": "/gratis-proefles", "destination": "/proefles/", "permanent": true },
    { "source": "/over/", "destination": "/over-ons/", "permanent": true },
    { "source": "/tarieven-pakketten/", "destination": "/tarieven/", "permanent": true },
    { "source": "/algemene-voorwaarden/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
